<Project>
  <PropertyGroup>
    <Authors>ActusLabs</Authors>
    <Company>ActusLabs</Company>
    <Copyright>Copyright © ActusLabs $([System.DateTime]::UtcNow.Year)</Copyright>
    <PackageTags>actus insurance actuarial finance contracts</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <!-- Default version used for local builds; CI overrides this via -p:Version -->
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
